{
  "name": "music-share-backend",
  "version": "1.0.0",
  "description": "SenacMusicShare Backend — monorepo root (api + worker)",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "api",
    "worker"
  ],
  "scripts": {
    "format": "prettier --write \"api/src/**/*.ts\" \"api/test/**/*.ts\" \"worker/src/**/*.ts\" \"worker/test/**/*.ts\"",
    "format:check": "prettier --check \"api/src/**/*.ts\" \"api/test/**/*.ts\" \"worker/src/**/*.ts\" \"worker/test/**/*.ts\"",
    "lint": "eslint \"api/src/**/*.ts\" \"api/test/**/*.ts\" \"worker/src/**/*.ts\" \"worker/test/**/*.ts\"",
    "test": "npm test --workspace=api && npm test --workspace=worker"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "prettier": "^3.4.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
